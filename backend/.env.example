# Copy this to .env and fill in your key(s).
# Provider preference: AI_PROVIDER=gemini | openai | auto (default).
# In "auto", Gemini is used if GEMINI_API_KEY is set, else OpenAI, else offline.
AI_PROVIDER=auto

# Gemini (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./projectpilot.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
